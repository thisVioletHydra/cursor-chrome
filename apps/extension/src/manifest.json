{
  "manifest_version": 3,
  "name": "Cursor Chrome",
  "version": "0.2.0",
  "key": "",
  "description": "Lets the Cursor agent control this Chrome via a local WebSocket.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cursor Chrome",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "activeTab",
    "scripting",
    "tabs",
    "offscreen",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
