{
  "name": "cursor-chrome",
  "version": "0.5.133",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "preflight": "pnpm --filter @cursor-chrome/hh preflight",
    "dev": "pnpm --filter @cursor-chrome/mcp start",
    "install-host": "pnpm --filter @cursor-chrome/native-host run install-host",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "sync-facts": "pnpm --filter @cursor-chrome/hh sync-facts"
  },
  "devDependencies": {
    "@oxyhub/oxlint-plugin": "^0.3.1",
    "oxlint": "^1.83.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
